# Copy this file to .env before running Docker Compose.
# Fill every required blank secret before starting Compose. Never commit .env.
# Use a strong password that meets SQL Server complexity requirements.
SQL_SA_PASSWORD=

# Host ports. Change these only if they conflict with software already running locally.
WEB_PORT=8080
AI_PORT=8000
SQL_PORT=14333

# JWT used by the mobile/REST API. Generate a long random value for real deployment.
JWT_KEY=
JWT_ISSUER=AgroVisionAI
JWT_AUDIENCE=AgroVisionAI.Mobile
JWT_ACCESS_TOKEN_MINUTES=60

# Optional default administrator for Docker/demo environments.
# Leave disabled in production unless you explicitly want startup seeding.
ADMIN_SEED_ENABLED=false
ADMIN_EMAIL=admin@agrovision.local
ADMIN_FULL_NAME=AgroVision Admin
ADMIN_PASSWORD=
# Shared secret used only for ASP.NET -> FastAPI model-management calls.
AI_ADMIN_KEY=
