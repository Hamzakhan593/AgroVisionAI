@{
    ViewData["Title"] = "AI-Powered Crop Disease Diagnostic System";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center g-5">

            <!-- Left: Value Proposition & Key Metrics -->
            <div class="col-lg-6">
                <span class="eyebrow">
                    <i class="bi bi-patch-check-fill" aria-hidden="true"></i> Next-Gen AgroVision Engine
                </span>

                <h1 class="hero-title">
                    Smarter decisions for <span>healthier crops</span>.
                </h1>

                <p class="hero-description">
                    Upload a leaf photograph to instantly identify crop diseases, evaluate severity metrics, and receive verified agronomic treatments.
                </p>

                <div class="hero-actions">
                    <a asp-controller="Detection" asp-action="Index" class="btn btn-primary-custom btn-lg">
                        <i class="bi bi-camera-fill me-2" aria-hidden="true"></i> Check Your Crop
                    </a>
                    <a href="#how-it-works" class="btn btn-outline-custom btn-lg">
                        How It Works
                    </a>
                </div>

                <div class="hero-stats">
                    <div class="stat-item">
                        <h4>98.2%</h4>
                        <p>Model Accuracy</p>
                    </div>
                    <div class="stat-item">
                        <h4>3 Core</h4>
                        <p>Crops Covered</p>
                    </div>
                    <div class="stat-item">
                        <h4>&lt; 2s</h4>
                        <p>Inference Time</p>
                    </div>
                </div>
            </div>

            <!-- Right: Interactive Diagnostic Visual Simulation -->
            <div class="col-lg-6">
                <div class="hero-visual-card">
                    <img src="~/images/cotton.jpg" alt="Crop leaf under AI diagnostic examination" class="hero-main-img" />

                    <!-- Dynamic Floating Diagnostic Result Simulation -->
                    <div class="floating-diagnostic">
                        <div class="d-flex justify-content-between align-items-center mb-1">
                            <span class="badge bg-success-subtle text-success border border-success-subtle px-2.5 py-1 fw-semibold">
                                <i class="bi bi-shield-check me-1" aria-hidden="true"></i> Diagnosis Result
                            </span>
                            <span class="small fw-bold text-dark">96.4% Match</span>
                        </div>
                        <div class="fw-bold text-dark mt-1">Bacterial Leaf Blight</div>
                        <div class="confidence-bar" role="progressbar" aria-valuenow="96" aria-valuemin="0" aria-valuemax="100">
                            <div class="confidence-fill"></div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>
</section>

<!-- Features / Capabilities Section -->
<section class="section-pad bg-light" id="features">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">Key Capabilities</span>
            <h2>Precision AI diagnosis made practical</h2>
            <p>Empowering local farming with rapid early detection to protect yields and lower chemical overhead.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrap">
                        <i class="bi bi-upc-scan" aria-hidden="true"></i>
                    </div>
                    <h3>Early Detection</h3>
                    <p>Detect pathogen signs before visible field-wide outbreaks occur, preserving root stock and overall harvest yield.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrap">
                        <i class="bi bi-cpu-fill" aria-hidden="true"></i>
                    </div>
                    <h3>Confidence Scoring</h3>
                    <p>Receive probabilistic assessments indicating detection reliability, preventing inaccurate or unnecessary pesticide use.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="feature-box">
                    <div class="feature-icon-wrap">
                        <i class="bi bi-shield-shaded" aria-hidden="true"></i>
                    </div>
                    <h3>Targeted Treatment</h3>
                    <p>Access structured chemical and organic management practices tailored specifically to the diagnosed crop condition.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- How It Works Section -->
<section class="section-pad" id="how-it-works">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">Step-by-Step</span>
            <h2>Simple diagnostic workflow</h2>
            <p>From visual inspection in the field to actionable recommendations in three straightforward steps.</p>
        </div>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="step-card">
                    <span class="step-badge">STEP 01</span>
                    <div class="step-icon-wrap">
                        <i class="bi bi-cloud-arrow-up-fill" aria-hidden="true"></i>
                    </div>
                    <h3>Upload Leaf Image</h3>
                    <p>Take or select a sharp, well-lit photo of the affected crop leaf through the intuitive upload interface.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="step-card">
                    <span class="step-badge">STEP 02</span>
                    <div class="step-icon-wrap">
                        <i class="bi bi-gear-wide-connected" aria-hidden="true"></i>
                    </div>
                    <h3>Neural Analysis</h3>
                    <p>The system evaluates leaf patterns, discolorations, and lesions against specialized crop disease classification models.</p>
                </div>
            </div>

            <div class="col-md-4">
                <div class="step-card">
                    <span class="step-badge">STEP 03</span>
                    <div class="step-icon-wrap">
                        <i class="bi bi-journal-medical" aria-hidden="true"></i>
                    </div>
                    <h3>Review Action Plan</h3>
                    <p>Review the disease profile, severity level, prevention tips, and recommended chemical or organic treatments.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Supported Crops Section -->
<section class="section-pad bg-light" id="crops">
    <div class="container">
        <div class="section-head">
            <span class="eyebrow">Supported Crops</span>
            <h2>Specialized detection pipelines</h2>
            <p>Custom-trained neural network architectures calibrated for major regional agricultural staples.</p>
        </div>

        <div class="row g-4">
            <!-- Cotton -->
            <div class="col-md-4">
                <div class="crop-card-v2">
                    <div class="crop-card-media">
                        <span class="crop-tag">Cotton CROP</span>
                        <img src="~/images/cotton1.jpg" alt="Cotton leaf sample" />
                    </div>
                    <div class="crop-card-body">
                        <h3>Cotton</h3>
                        <p>Identify Leaf Curl Virus, Bacterial Blight, Alternaria Leaf Spot, and nutrient deficiency markers.</p>
                        <a asp-controller="Detection" asp-action="Index" asp-route-crop="cotton" class="crop-action-link">
                            Inspect Cotton <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Wheat -->
            <div class="col-md-4">
                <div class="crop-card-v2">
                    <div class="crop-card-media">
                        <span class="crop-tag">WHEAT CROP</span>
                        <img src="~/images/wheat.jpg" alt="Wheat leaf sample" />
                    </div>
                    <div class="crop-card-body">
                        <h3>Wheat</h3>
                        <p>Screen for Yellow Rust, Brown Leaf Rust, Powdery Mildew, and Septoria leaf blotch damage.</p>
                        <a asp-controller="Detection" asp-action="Index" asp-route-crop="wheat" class="crop-action-link">
                            Inspect Wheat <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>

            <!-- Rice -->
            <div class="col-md-4">
                <div class="crop-card-v2">
                    <div class="crop-card-media">
                        <span class="crop-tag">RICE CROP</span>
                        <img src="~/images/rice.jpg" alt="Rice leaf sample" />
                    </div>
                    <div class="crop-card-body">
                        <h3>Rice</h3>
                        <p>Detect Rice Blast, Brown Spot, Bacterial Panicle Blight, and Sheath Rot symptoms rapidly.</p>
                        <a asp-controller="Detection" asp-action="Index" asp-route-crop="rice" class="crop-action-link">
                            Inspect Rice <i class="bi bi-arrow-right" aria-hidden="true"></i>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Call To Action Section -->
<section class="section-pad" id="about">
    <div class="container">
        <div class="cta-banner text-center">
            <div class="eyebrow eyebrow-light mb-3">
                Fast &amp; Field-Ready
            </div>
            <h2>Ready to diagnose your crop?</h2>
            <p>Upload a clear crop image now to receive a diagnosis report with guided treatment steps in seconds.</p>
            <a asp-controller="Detection" asp-action="Index" class="btn btn-cta btn-lg">
                <i class="bi bi-camera-fill me-2" aria-hidden="true"></i> Launch Detection Tool
            </a>
        </div>
    </div>
</section>