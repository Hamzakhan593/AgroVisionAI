@model IEnumerable<AgroVisionAI.Models.Detection>

@{
    ViewData["Title"] = "Analysis History";
}

<div class="history-page">
    <div class="container">
        <div class="history-header">
            <div>
                <span class="dashboard-eyebrow">YOUR ACTIVITY</span>
                <h1>Analysis History</h1>
                <p>Review your previous crop predictions, confidence scores and guidance.</p>
            </div>

            <a asp-controller="Detection"
               asp-action="Index"
               class="btn dashboard-primary-btn">
                <i class="bi bi-camera-fill"></i>
                Scan New Crop
            </a>
        </div>

        @if (!Model.Any())
        {
            <div class="history-empty">
                <div class="empty-history-icon">
                    <i class="bi bi-clock-history"></i>
                </div>
                <h2>No analysis history yet</h2>
                <p>Your crop predictions will appear here after your first successful analysis.</p>
                <a asp-controller="Detection"
                   asp-action="Index"
                   class="btn dashboard-outline-btn">
                    Analyze Your First Crop
                </a>
            </div>
        }
        else
        {
            <div class="history-grid">
                @foreach (var detection in Model)
                {
                    var confidence = Math.Clamp((detection.Confidence ?? 0) * 100, 0, 100);

                    <div class="history-card">
                        <div class="history-image">
                            <img src="@Url.Action("Image", "Detection", new { id = detection.Id })"
                                 loading="lazy" alt="@detection.Crop crop image" />
                        </div>

                        <div class="history-content">
                            <div class="history-card-top">
                                <span class="history-crop">@detection.Crop</span>
                                <span class="history-status">@confidence.ToString("0.0")% disease confidence</span>
                            </div>

                            <strong class="history-condition">
                                @(detection.Disease?.Name ?? "Result unavailable")
                            </strong>

                            <p class="history-date">
                                @detection.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")
                            </p>

                            <a asp-controller="Detection"
                               asp-action="Result"
                               asp-route-id="@detection.Id"
                               class="history-view-link">
                                View Analysis
                                <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                }
            </div>
        }
    </div>
</div>
