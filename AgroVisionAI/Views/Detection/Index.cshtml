@{
    ViewData["Title"] = "Scan Your Crop";
}
<div class="detection-page">
    <div class="container">
        <div class="detection-header">
            <span class="dashboard-eyebrow">AUTOMATIC CROP CHECK</span>
            <h1>One leaf. Start here.</h1>
            <p>Upload a clear leaf photograph. We identify Cotton, Wheat, or Rice before checking for disease patterns.</p>
            @if (TempData["DetectionError"] != null)
            {
                <div class="alert alert-danger detection-alert" role="alert">@TempData["DetectionError"]</div>
            }
        </div>
        <div class="detection-card">
            <div class="auto-crop-info">
                <i class="bi bi-stars" aria-hidden="true"></i>
                <div><strong>No crop selection needed</strong><p>Cotton · Wheat · Rice. Unsupported or uncertain predictions are stopped before disease analysis.</p></div>
            </div>
            <form asp-controller="Detection" asp-action="Analyze" method="post" enctype="multipart/form-data" id="detectionForm">
                @Html.AntiForgeryToken()
                <div class="upload-section visible" id="uploadSection">
                    <div class="detection-step">
                        <span>01</span><h2>Upload a leaf photograph</h2>
                        <p>Show one leaf in focus, in natural light. Avoid grain heads, flowers, collages and screenshots.</p>
                    </div>
                    <div class="upload-area" id="dropZone">
                        <div class="upload-icon"><i class="bi bi-cloud-arrow-up" aria-hidden="true"></i></div>
                        <label for="cropImage" class="upload-label">Choose a leaf image</label>
                        <p>Or drag and drop one image here.</p>
                        <span class="upload-formats" id="fileHelp">JPG, JPEG or PNG · Maximum 5 MB</span>
                        <input type="file" id="cropImage" name="cropImage" accept=".jpg,.jpeg,.png" aria-describedby="fileHelp uploadFeedback" required />
                    </div>
                    <p id="uploadFeedback" class="upload-feedback" role="status" aria-live="polite"></p>
                    <div class="image-preview-container" id="imagePreviewContainer">
                        <img id="imagePreview" alt="Your selected leaf photograph" />
                        <div class="preview-info"><span id="imageFileName">Selected image</span>
                            <button type="button" id="removeImage" class="remove-image-btn">Remove image</button>
                        </div>
                    </div>
                    <button type="submit" id="analyzeButton" class="btn analyze-btn visible" disabled>
                        <i class="bi bi-stars" aria-hidden="true"></i><span>Detect crop &amp; analyze</span>
                    </button>
                    <p class="scan-disclaimer">AI can make mistakes, including confident ones. This is leaf-image decision support, not a laboratory diagnosis or a guarantee of crop identity.</p>
                </div>
            </form>
        </div>
    </div>
</div>
