@model AgroVisionAI.Models.Detection
@using AgroVisionAI.Models
@using System.Globalization
@{
    ViewData["Title"] = "Your crop care plan";
    var hasResult = Model.Disease != null && Model.Confidence.HasValue && double.IsFinite(Model.Confidence.Value);
    var healthy = Model.Disease?.Name.StartsWith("Healthy", StringComparison.OrdinalIgnoreCase) == true;
    var score = hasResult ? Math.Clamp(Model.Confidence!.Value * 100, 0, 100) : 0;
    var days = ViewData["DaysToHarvest"] as int?;
    var whitefly = ViewData["WhiteflyTreatmentNeeded"] as bool?;
    var reportDays = days is >= 0 ? days : null;
    var cottonCurl = Model.Crop.Equals("Cotton", StringComparison.OrdinalIgnoreCase) && Model.Disease?.Name == "Cotton Leaf Curl Virus";
    var cropScore = Model.CropConfidence.HasValue && double.IsFinite(Model.CropConfidence.Value)
        ? Math.Clamp(Model.CropConfidence.Value * 100, 0, 100)
        : (double?)null;
    var secondScore = Model.SecondConfidence.HasValue && double.IsFinite(Model.SecondConfidence.Value)
        ? Math.Clamp(Model.SecondConfidence.Value * 100, 0, 100)
        : (double?)null;
    var marginScore = Model.ConfidenceMargin.HasValue && double.IsFinite(Model.ConfidenceMargin.Value)
        ? Math.Clamp(Model.ConfidenceMargin.Value * 100, 0, 100)
        : (double?)null;
    var hasAuditMetadata = !string.IsNullOrWhiteSpace(Model.RequestId) ||
        !string.IsNullOrWhiteSpace(Model.DiseaseModelName) ||
        cropScore.HasValue || Model.ProcessingTimeMs.HasValue;
    var feedback = ViewData["PredictionFeedback"] as PredictionFeedback;
    var feedbackOptions = ViewData["FeedbackDiseaseOptions"] as string[] ?? Array.Empty<string>();
    var feedbackIncorrect = feedback?.Verdict == FeedbackVerdict.Incorrect;
    var hasGradCam = ViewData["GradCamAvailable"] is bool gradCamAvailable && gradCamAvailable;
}
<link rel="stylesheet" href="~/css/treatment-pk.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/care-result.css" asp-append-version="true" />
<div class="care-page">
    <nav class="care-breadcrumb" aria-label="Breadcrumb"><a asp-controller="Dashboard" asp-action="Index">Dashboard</a><span>/</span><a asp-controller="History" asp-action="Index">My analyses</a><span>/</span><span>Care plan</span></nav>
    <header class="care-heading"><div><span class="care-eyebrow">AGROVISION AI · PAKISTAN CROP CARE</span><h1><span class="lang-ur">Aapki fasal ka ilaaj aur dekh bhaal</span><span class="lang-en">Your crop. A clearer next step.</span></h1><p><span class="lang-ur">Bimari ka natija dekhein, phir neeche bataye gaye dekh bhaal ke tareeqay aur dawa ki maloomat parhein.</span><span class="lang-en">Review the suspected condition, then explore the matching care and chemical options.</span></p></div><div class="care-heading-actions"><a class="care-button care-button-secondary" asp-action="ExportReport" asp-route-id="@Model.Id" asp-route-daysToHarvest="@reportDays" asp-route-whiteflyTreatmentNeeded="@whitefly"><i class="bi bi-file-earmark-pdf" aria-hidden="true"></i> <span class="lang-ur">PDF report</span><span class="lang-en">Download PDF report</span></a><a class="care-button" asp-action="Index"><i class="bi bi-camera" aria-hidden="true"></i> <span class="lang-ur">Nayi tasveer check karein</span><span class="lang-en">Analyze another leaf</span></a></div></header>
    @if (TempData["ReportError"] is string reportError)
    {
        <div class="care-report-error" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @reportError</div>
    }
    <div class="care-overview">
        <figure class="care-photo"><img src="@Url.Action("Image", "Detection", new { id = Model.Id })" alt="Uploaded @Model.Crop leaf" /><figcaption><span><span class="lang-ur">AAPKI BHEJI HUI TASVEER</span><span class="lang-en">YOUR UPLOADED IMAGE</span></span><strong>@Model.Crop</strong></figcaption></figure>
        <section class="care-diagnosis" aria-labelledby="diagnosis-title">
            <div class="care-status"><span class="care-dot"></span><span class="lang-ur">@(hasResult ? healthy ? "Koi pehchani hui bimari nazar nahi aayi" : "Bimari ki alamat nazar aayi hain" : "Natija dastiyab nahi")</span><span class="lang-en">@(hasResult ? healthy ? "No supported disease detected" : "Disease pattern identified" : "Prediction unavailable")</span></div>
            <span class="care-eyebrow"><span class="lang-ur">@(healthy ? "TASVEER KA NATIJA" : "MUMKINA BIMARI")</span><span class="lang-en">@(healthy ? "IMAGE RESULT" : "SUSPECTED CONDITION")</span></span><h2 id="diagnosis-title">@(Model.Disease?.Name ?? "No saved prediction")</h2>
            <p class="lang-en">@Model.Disease?.Description</p>
            <div class="care-metrics"><div><span><span class="lang-ur">Fasal</span><span class="lang-en">Crop detected</span></span><strong>@Model.Crop</strong></div><div><span><span class="lang-ur">Model ka aitmaad</span><span class="lang-en">Model confidence</span></span><strong>@(hasResult ? score.ToString("0.0") + "%" : "Unavailable")</strong></div><div><span><span class="lang-ur">Report number</span><span class="lang-en">Analysis reference</span></span><strong>#@Model.Id</strong></div></div>
            @if (hasResult)
            { <div class="care-score" role="progressbar" aria-label="Model confidence, not severity" aria-valuemin="0" aria-valuemax="100" aria-valuenow="@score.ToString("0.0", CultureInfo.InvariantCulture)"><span style="width:@(score.ToString("0.0", CultureInfo.InvariantCulture))%"></span></div> }
            <p class="care-note"><i class="bi bi-info-circle" aria-hidden="true"></i> <span class="lang-ur">Yeh percentage model ke aitmaad ko dikhati hai, bimari ki shiddat ko nahi. Sirf tasveer se laboratory wali tasdeeq nahi hoti.</span><span class="lang-en">Confidence describes the model's prediction, not disease severity. A photo is not a laboratory diagnosis.</span></p>
        </section>
    </div>
    @if (hasGradCam)
    {
        <section class="care-xai" aria-labelledby="xai-title">
            <div class="care-xai-copy">
                <span class="care-eyebrow"><span class="lang-ur">EXPLAINABLE AI · GRAD-CAM</span><span class="lang-en">EXPLAINABLE AI · GRAD-CAM</span></span>
                <h2 id="xai-title"><span class="lang-ur">AI ne tasveer mein kin hisson par zyada tawajjoh di?</span><span class="lang-en">What influenced the AI prediction?</span></h2>
                <p><span class="lang-ur">Rang wala heatmap un hisson ko highlight karta hai jo model ke final prediction par zyada asar dalte hain. Laal aur peelay areas zyada model attention dikhate hain.</span><span class="lang-en">The heatmap highlights image regions that had stronger influence on the model's predicted class. Warmer yellow/red areas indicate stronger model attention.</span></p>
                <div class="care-xai-warning"><i class="bi bi-info-circle" aria-hidden="true"></i><span><span class="lang-ur">Yeh disease severity, infected area ki exact measurement, ya laboratory proof nahi hai. Yeh sirf model ki attention ko explain karta hai.</span><span class="lang-en">This is not disease severity, an exact infected-area measurement, or laboratory proof. It only visualizes model attention.</span></span></div>
            </div>
            <figure class="care-xai-figure">
                <img src="@Url.Action("ExplanationImage", "Detection", new { id = Model.Id })" alt="Grad-CAM explanation heatmap for the saved @Model.Crop prediction" />
                <figcaption><i class="bi bi-fire" aria-hidden="true"></i> Grad-CAM attention overlay</figcaption>
            </figure>
        </section>
    }

    @if (hasAuditMetadata)
    {
        <details class="care-audit">
            <summary>
                <span><i class="bi bi-cpu" aria-hidden="true"></i> <span class="lang-ur">AI technical details</span><span class="lang-en">AI technical details</span></span>
                <small><span class="lang-ur">Model tracking aur prediction audit</span><span class="lang-en">Model tracking and prediction audit</span></small>
            </summary>
            <div class="care-audit-grid">
                <div><span>Crop confidence</span><strong>@(cropScore.HasValue ? cropScore.Value.ToString("0.0") + "%" : "Unavailable")</strong></div>
                <div><span>Disease confidence</span><strong>@(hasResult ? score.ToString("0.0") + "%" : "Unavailable")</strong></div>
                <div><span>Second prediction</span><strong>@(!string.IsNullOrWhiteSpace(Model.SecondPredictionName) ? Model.SecondPredictionName : "Unavailable")</strong></div>
                <div><span>Second confidence</span><strong>@(secondScore.HasValue ? secondScore.Value.ToString("0.0") + "%" : "Unavailable")</strong></div>
                <div><span>Top-1 / Top-2 margin</span><strong>@(marginScore.HasValue ? marginScore.Value.ToString("0.0") + "%" : "Unavailable")</strong></div>
                <div><span>Inference time</span><strong>@(Model.ProcessingTimeMs.HasValue && double.IsFinite(Model.ProcessingTimeMs.Value) ? Model.ProcessingTimeMs.Value.ToString("0.0") + " ms" : "Unavailable")</strong></div>
                <div><span>Crop validator</span><strong>@(!string.IsNullOrWhiteSpace(Model.CropModelVersion) ? Model.CropModelVersion : "—")</strong><small>@Model.CropModelName</small></div>
                <div><span>Disease model</span><strong>@(!string.IsNullOrWhiteSpace(Model.DiseaseModelVersion) ? Model.DiseaseModelVersion : "—")</strong><small>@Model.DiseaseModelName</small></div>
                <div><span>Internal class</span><strong>@(!string.IsNullOrWhiteSpace(Model.PredictedClass) ? Model.PredictedClass : "Unavailable")</strong></div>
                <div class="care-audit-request"><span>Request ID</span><code>@(Model.RequestId ?? "Unavailable")</code></div>
            </div>
            <p class="care-note"><i class="bi bi-shield-check" aria-hidden="true"></i> These values are saved with this analysis for traceability. Confidence margin is Top-1 minus Top-2 disease confidence; it is not disease severity.</p>
        </details>
    }
    @if (hasResult)
    {
        <section class="care-feedback" id="prediction-feedback" aria-labelledby="prediction-feedback-title">
            <div class="care-feedback-head">
                <div>
                    <span class="care-eyebrow"><span class="lang-ur">AI KO BEHTAR BANANE MEIN MADAD</span><span class="lang-en">HUMAN FEEDBACK LOOP</span></span>
                    <h2 id="prediction-feedback-title"><span class="lang-ur">Kya AI ka natija sahi tha?</span><span class="lang-en">Was this AI prediction correct?</span></h2>
                    <p><span class="lang-ur">Aapka jawab model ki real-world quality ko samajhne aur ghalat predictions ko review karne mein madad karta hai.</span><span class="lang-en">Your answer helps us measure real-world model quality and collect mistakes for review.</span></p>
                </div>
                @if (feedback != null)
                {
                    var statusText = feedback.VerificationStatus switch
                    {
                        FeedbackVerificationStatus.Verified => "Verified",
                        FeedbackVerificationStatus.Rejected => "Reviewed",
                        _ => "Pending review"
                    };
                    <span class="care-feedback-status care-feedback-status-@(feedback.VerificationStatus.ToString().ToLowerInvariant())">
                        <i class="bi bi-check2-circle" aria-hidden="true"></i> @statusText
                    </span>
                }
            </div>

            @if (TempData["FeedbackSuccess"] is string feedbackSuccess)
            {
                <div class="care-feedback-message care-feedback-success" role="status"><i class="bi bi-check-circle" aria-hidden="true"></i> @feedbackSuccess</div>
            }
            @if (TempData["FeedbackError"] is string feedbackError)
            {
                <div class="care-feedback-message care-feedback-error" role="alert"><i class="bi bi-exclamation-triangle" aria-hidden="true"></i> @feedbackError</div>
            }

            @if (feedback?.VerificationStatus == FeedbackVerificationStatus.Verified)
            {
                <div class="care-feedback-message care-feedback-success" role="status">
                    <i class="bi bi-person-check" aria-hidden="true"></i>
                    Expert review completed. Verified label: <strong>@(feedback.VerifiedDisease ?? "Reviewed")</strong>.
                </div>
            }
            else if (feedback?.VerificationStatus == FeedbackVerificationStatus.Rejected)
            {
                <div class="care-feedback-message care-feedback-error" role="status">
                    <i class="bi bi-shield-x" aria-hidden="true"></i>
                    This feedback was reviewed but was not accepted as a verified retraining label.
                </div>
            }

            <form method="post" action="@Url.Action("SubmitFeedback", "Detection")" class="care-feedback-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="detectionId" value="@Model.Id" />

                <fieldset>
                    <legend class="visually-hidden">Prediction feedback</legend>
                    <div class="care-feedback-choices">
                        <div class="care-feedback-choice">
                            <input id="feedback-correct" type="radio" name="verdict" value="Correct" required checked="@(feedback?.Verdict == FeedbackVerdict.Correct)" />
                            <label for="feedback-correct"><i class="bi bi-hand-thumbs-up" aria-hidden="true"></i><span><strong><span class="lang-ur">Haan, sahi tha</span><span class="lang-en">Yes, correct</span></strong><small><span class="lang-ur">Natija tasveer aur fasal se match karta hai.</span><span class="lang-en">The result matches the crop image.</span></small></span></label>
                        </div>
                        <div class="care-feedback-choice">
                            <input id="feedback-incorrect" type="radio" name="verdict" value="Incorrect" required checked="@(feedback?.Verdict == FeedbackVerdict.Incorrect)" />
                            <label for="feedback-incorrect"><i class="bi bi-hand-thumbs-down" aria-hidden="true"></i><span><strong><span class="lang-ur">Nahi, ghalat tha</span><span class="lang-en">No, incorrect</span></strong><small><span class="lang-ur">Agar maloom ho to sahi condition select karein.</span><span class="lang-en">You can suggest the correct condition below.</span></small></span></label>
                        </div>
                        <div class="care-feedback-choice">
                            <input id="feedback-unsure" type="radio" name="verdict" value="NotSure" required checked="@(feedback?.Verdict == FeedbackVerdict.NotSure)" />
                            <label for="feedback-unsure"><i class="bi bi-question-circle" aria-hidden="true"></i><span><strong><span class="lang-ur">Pakka nahi</span><span class="lang-en">Not sure</span></strong><small><span class="lang-ur">Aap tasdeeq nahi kar sakte to ye option choose karein.</span><span class="lang-en">Use this if you cannot confidently verify it.</span></small></span></label>
                        </div>
                    </div>
                </fieldset>

                <div id="feedback-correction" class="care-feedback-correction @(feedbackIncorrect ? "" : "is-hidden")">
                    <label for="suggestedDisease"><span class="lang-ur">Aapke khayal mein sahi condition kya hai?</span><span class="lang-en">What do you think the correct condition is?</span></label>
                    <select id="suggestedDisease" name="suggestedDisease">
                        <option value="">Select only if you know (optional)</option>
                        @foreach (var option in feedbackOptions)
                        {
                            <option value="@option" selected="@(string.Equals(feedback?.SuggestedDisease, option, StringComparison.OrdinalIgnoreCase))">@option</option>
                        }
                    </select>
                </div>

                <label class="care-feedback-note-label" for="feedback-comment"><span class="lang-ur">Chhota note <span>(optional)</span></span><span class="lang-en">Short note <span>(optional)</span></span></label>
                <textarea id="feedback-comment" name="comment" maxlength="500" rows="3" placeholder="e.g. field symptoms, expert/lab confirmation, or why the result looks wrong">@feedback?.Comment</textarea>

                <div class="care-feedback-actions">
                    <p><i class="bi bi-shield-check" aria-hidden="true"></i> <span class="lang-ur">Feedback seedha model ko retrain nahi karta. Pehle review ke liye save hota hai.</span><span class="lang-en">Feedback is stored for review; it never automatically retrains or overrides the model.</span></p>
                    <button type="submit" class="care-button"><i class="bi bi-send" aria-hidden="true"></i> <span class="lang-ur">Feedback save karein</span><span class="lang-en">Save feedback</span></button>
                </div>
            </form>
        </section>
    }

    @if (hasResult)
    {
        <div class="care-content">
            <aside class="care-sidebar">
                <section class="care-panel"><span class="care-eyebrow"><span class="lang-ur">KHET KI MALOOMAT</span><span class="lang-en">FIELD CHECK</span></span><h2><span class="lang-ur">Spray se pehle</span><span class="lang-en">Before you spray</span></h2><p><span class="lang-ur">Katai mein kitne din baqi hain? Is se pata chalega ke dawa ke baad zaroori intezar ka waqt mil sakta hai ya nahi.</span><span class="lang-en">Your harvest timing helps check whether a chemical option fits.</span></p>
                    @if (ViewData["FieldContextError"] is string error) { <p class="care-error" role="alert">@error</p> }
                    <form method="get" action="@Url.Action("Result", new { id = Model.Id })">
                        <label for="care-days"><span class="lang-ur">Katai mein baqi din <span>(agar maloom hon)</span></span><span class="lang-en">Days until harvest <span>(optional)</span></span></label><input id="care-days" type="number" name="daysToHarvest" min="0" max="365" step="1" value="@(days >= 0 ? days : null)" placeholder="Din likhein / Enter days" />
                        @if (cottonCurl)
                        {
                            <label for="care-whitefly"><span class="lang-ur">Kya khet ka muaina karke safed makhi ke khilaf dawa ki zaroorat ki tasdeeq hui hai?</span><span class="lang-en">Has a local field assessment confirmed a need to treat whitefly?</span></label>
                            <select id="care-whitefly" name="whiteflyTreatmentNeeded"><option value="">Abhi muaina nahi hua / Not assessed</option><option value="true" selected="@(whitefly == true)">Haan, zaroorat hai / Confirmed</option><option value="false" selected="@(whitefly == false)">Nahi / No</option></select>
                        }
                        <button type="submit" class="care-button"><span class="lang-ur">Maloomat ke mutabiq dobara dekhein</span><span class="lang-en">Update care options</span> <i class="bi bi-arrow-right" aria-hidden="true"></i></button>
                        <p class="care-note"><span class="lang-ur">Isi report mein dawa ki maloomat dobara check hogi. Nayi tasveer dene ki zaroorat nahi.</span><span class="lang-en">This updates the care plan for this saved result. No new photo or disease selection is needed.</span></p>
                    </form>
                </section>
                <section class="care-panel care-soft"><h2><span class="lang-ur">Kin alamat ko dekhein? (English)</span><span class="lang-en">What to look for</span></h2><p>@Model.Disease?.Symptoms</p></section>
                <section class="care-panel"><h2><span class="lang-ur">Dawa ki maloomat kahan se aayi?</span><span class="lang-en">Read the evidence</span></h2><p><span class="lang-ur">Har dawa ke saath Pakistan mein manufacturer ka hawala diya gaya hai. Jahan koi tafseel nahi mili, woh bhi wazeh likha hai.</span><span class="lang-en">Each chemical card links to the Pakistan manufacturer and shows which details are available.</span></p><p class="care-note"><span class="lang-ur">Manufacturer ki maloomat ko registration ki azad tasdeeq ya aapke khet ke liye nuskha na samjhein.</span><span class="lang-en">Published product information is not independent registration verification or a personalized prescription.</span></p></section>
            </aside>
            <div class="care-main" id="care-plan">
                @await Component.InvokeAsync("TreatmentPk", new { detectionId = Model.Id, daysToHarvest = days, whiteflyTreatmentNeeded = whitefly })
            </div>
        </div>
    }
    else { <section class="care-panel"><p><span class="lang-ur">Bimari ka mukammal natija maujood nahi. Care plan ke liye nayi tasveer check karein.</span><span class="lang-en">No completed prediction is saved. Run a new analysis to generate a care plan.</span></p></section> }
    <footer class="care-footer"><span><span class="lang-ur">Rehnumai aapki fasal aur pehchani gayi bimari ke mutabiq hai.</span><span class="lang-en">Care advice follows the detected crop and condition.</span></span><a asp-controller="History" asp-action="Index"><span class="lang-ur">Purani reports dekhein</span><span class="lang-en">View analysis history</span> <i class="bi bi-arrow-right" aria-hidden="true"></i></a></footer>
</div>


@section Scripts {
    <script>
        (() => {
            const incorrect = document.getElementById('feedback-incorrect');
            const correction = document.getElementById('feedback-correction');
            const radios = document.querySelectorAll('input[name="verdict"]');
            if (!incorrect || !correction || radios.length === 0) return;

            const syncCorrection = () => {
                correction.classList.toggle('is-hidden', !incorrect.checked);
            };

            radios.forEach(radio => radio.addEventListener('change', syncCorrection));
            syncCorrection();
        })();
    </script>
}
